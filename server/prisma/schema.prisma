generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────

enum RelevanceLabel {
  relevant
  irrelevant
  starred
}

enum GenerationMode {
  single_topic
  aggregated
}

enum GeneratedPostStatus {
  draft
  published
  discarded
  edited
}

// ── Accounts & Sessions ───────────────────────────────────────────────

model Account {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String   @map("password_hash")
  scoringConfig    Json?    @map("scoring_config")
  aiConfig         Json?    @map("ai_config")
  engagementConfig Json?    @map("engagement_config")
  createdAt        DateTime @default(now()) @map("created_at")

  sessions       Session[]
  posts          Post[]
  generatedPosts GeneratedPost[]

  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  accountId    String   @map("account_id")
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("sessions")
}

// ── Posts ──────────────────────────────────────────────────────────────

model Post {
  id                 String          @id @default(uuid())
  accountId          String          @map("account_id")
  externalId         String          @map("external_id")
  authorName         String          @map("author_name")
  authorHeadline     String?         @map("author_headline")
  authorProfileUrl   String?         @map("author_profile_url")
  authorTier         Int?            @map("author_tier")
  content            String
  language           String?
  postedAt           DateTime?       @map("posted_at")
  reactions          Int             @default(0)
  comments           Int             @default(0)
  reposts            Int             @default(0)
  hashtags           String[]
  mentions           String[]
  media              Json?
  score              Float?
  scoreBreakdown     Json?           @map("score_breakdown")
  assignedCategories String[]        @map("assigned_categories")
  relevanceLabel     RelevanceLabel? @map("relevance_label")
  scrapedAt          DateTime?       @map("scraped_at")
  scrapedBySession   String?         @map("scraped_by_session")
  rawPayload         Json?           @map("raw_payload")
  createdAt          DateTime        @default(now()) @map("created_at")

  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  postTopics PostTopic[]

  @@unique([accountId, externalId])
  @@index([accountId, scrapedAt])
  @@index([accountId, createdAt])
  @@map("posts")
}

// ── Topics ─────────────────────────────────────────────────────────────

model Topic {
  id          String   @id @default(uuid())
  slug        String   @unique
  label       String
  category    String[]
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  postTopics     PostTopic[]
  generatedPosts GeneratedPost[]

  @@map("topics")
}

model PostTopic {
  id          String   @id @default(uuid())
  postId      String   @map("post_id")
  topicId     String   @map("topic_id")
  confidence  Float
  extractedAt DateTime @default(now()) @map("extracted_at")

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([postId, topicId])
  @@index([topicId])
  @@map("post_topics")
}

// ── Generated Posts ────────────────────────────────────────────────────

model GeneratedPost {
  id           String              @id @default(uuid())
  accountId    String              @map("account_id")
  topicId      String?             @map("topic_id")
  mode         GenerationMode
  toneSettings Json                @map("tone_settings")
  prompt       String
  model        String
  provider     String
  outputText   String              @map("output_text")
  status       GeneratedPostStatus @default(draft)
  myEditedText String?             @map("my_edited_text")
  createdAt    DateTime            @default(now()) @map("created_at")
  publishedAt  DateTime?           @map("published_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([accountId, status])
  @@index([accountId, createdAt])
  @@map("generated_posts")
}

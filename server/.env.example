# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkedin_applier?schema=public

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Anthropic (server-side only - NEVER expose to extension)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_TOPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_GENERATION_MODEL=claude-sonnet-4-6

# Server
PORT=3000
NODE_ENV=development

# Rate limiting
GENERATE_DAILY_LIMIT=30
